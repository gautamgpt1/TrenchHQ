<Project>
  <PropertyGroup>
    <WindowPinSource>$(MSBuildThisFileDirectory)</WindowPinSource>
  </PropertyGroup>
  <ItemGroup>
    <UpToDateCheckInput Include="$(WindowPinSource)WindowPin.cpp;$(WindowPinSource)Build.ps1;$(WindowPinSource)WindowPin.targets" />
  </ItemGroup>
  <Target Name="BuildWindowPin" BeforeTargets="PrepareForBuild" Condition="'$(Platform)' == 'x64' and '$(DesignTimeBuild)' != 'true'">
    <GetFileHash Files="$(WindowPinSource)WindowPin.cpp">
      <Output TaskParameter="Hash" PropertyName="WindowPinSourceHash" />
    </GetFileHash>
    <GetFileHash Files="$(WindowPinSource)Build.ps1">
      <Output TaskParameter="Hash" PropertyName="WindowPinBuildHash" />
    </GetFileHash>
    <PropertyGroup>
      <WindowPinHash>$([System.String]::Copy('$(WindowPinSourceHash)').Substring(0,16))$([System.String]::Copy('$(WindowPinBuildHash)').Substring(0,16))</WindowPinHash>
      <WindowPinFile>TrenchHQ.WindowPin.$(WindowPinHash).dll</WindowPinFile>
      <WindowPinOutput>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)WindowPin</WindowPinOutput>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(WindowPinSource)Build.ps1&quot; -OutputPath &quot;$(WindowPinOutput)&quot; -FileName &quot;$(WindowPinFile)&quot;" />
    <WriteLinesToFile File="$(WindowPinOutput)\TrenchHQ.WindowPin.version" Lines="$(WindowPinFile)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="$(WindowPinOutput)\$(WindowPinFile)">
        <Link>$(WindowPinFile)</Link>
        <TargetPath>$(WindowPinFile)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="$(WindowPinOutput)\TrenchHQ.WindowPin.version">
        <Link>TrenchHQ.WindowPin.version</Link>
        <TargetPath>TrenchHQ.WindowPin.version</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
