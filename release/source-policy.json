{
  "include": [
    "*.cs",
    "*.xaml",
    "*.manifest",
    "*.appxmanifest",
    "TrenchHQ.csproj",
    "TrenchHQ.slnx",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "AGENTS.md",
    ".gitignore",
    ".gitattributes",
    "global.json",
    "Controls/**",
    "Helpers/**",
    "Models/**",
    "Views/**",
    "Assets/**",
    "Properties/launchSettings.json",
    "Properties/PublishProfiles/win-x64.pubxml",
    "Native/WindowPin/*.cpp",
    "Native/WindowPin/*.ps1",
    "Native/WindowPin/*.targets",
    "OnChainTransport/*.csproj",
    "OnChainEngine/Cargo.toml",
    "OnChainEngine/Cargo.lock",
    "OnChainEngine/src/**",
    "OnChainEngine/tests/**",
    "ThirdParty/**",
    "SidecarApp/main.cjs",
    "SidecarApp/package.json",
    "SidecarApp/package-lock.json",
    "Tests/**/*.cs",
    "Tests/**/*.csproj",
    "Tests/**/*.ps1",
    "Tests/**/*.cpp",
    "Tests/**/*.cjs",
    "Tests/**/*.json",
    "Scripts/**",
    "release/**",
    "docs/public/**",
    ".github/**",
    "Directory.Build.props",
    "packages.lock.json",
    "OnChainTransport/packages.lock.json",
    "Tests/*.cjs",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/BUILD.md",
    "docs/ARCHITECTURE.md",
    "docs/SERVICES.md",
    "docs/RELEASE.md"
  ],
  "exclude": [
    "**/bin/**",
    "**/obj/**",
    "**/target/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/*.user",
    "**/*.pfx",
    "**/*.p12",
    "**/*.key",
    "**/*.log",
    "Assets/Protocols/pump.svg",
    "Assets/Protocols/meteora.svg",
    "**/__pycache__/**",
    "**/*.pyc"
  ],
  "policy": "Copy maintained project source into a new external candidate. Exclude restored runtimes, build output, local evidence, credentials and IDE state. Git history and candidate audit metadata are not public source files. Restore Node and the sidecar from locked inputs."
}
