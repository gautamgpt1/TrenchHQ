<UserControl
    x:Class="TrenchHQ.Views.HelpTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="32,24,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Help and FAQ" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Grid.Row="1" Text="Find answers and get support." Style="{StaticResource PageSubtitleStyle}" />
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Margin="32,12,32,0" />

        <StackPanel Grid.Row="2" Margin="32,16,32,0" Spacing="10">
            <TextBlock Text="FAQs" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Spacing="0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,10" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                </StackPanel.Resources>

                <Expander Header="How do I start without an API key?" IsExpanded="True" CornerRadius="12,12,0,0">
                    <TextBlock Text="In Widgets, create a Price Ticker, choose a public exchange and spot pair, then Save. In Desktop Setup, create an Overlay or screen-edge panel, assign that widget and select Show. No exchange login, wallet key or payment is required. PublicNode can also provide best-effort on-chain data on Ethereum, Base, BNB Smart Chain and Robinhood Chain. Solana live data requires a configured RPC provider; native X Tracker requires paid X API access. Regional restrictions and rate limits can affect public feeds." Style="{StaticResource BodyTextStyle}" Margin="16,0,16,0" />
                </Expander>
                <Expander Header="How do I recover a stopped or misplaced display?" CornerRadius="0">
                    <TextBlock Text="Use the notification-area TrenchHQ icon to reopen the dashboard. Stop Desktop Display releases all panels and pinned applications; start it again to restore the selected setup. Minimize is reversible, while Close requires Show to recreate that panel. After a network failure, automatic provider recovery keeps the selected polling or event mode. An unavailable value is not a current price. For a broken website, use Reload or Open in browser. Quit TrenchHQ before reinstalling. Keep private keys, tokens, wallet addresses and browser data out of support reports." Style="{StaticResource BodyTextStyle}" Margin="16,0,16,0" />
                </Expander>
                <Expander Header="How do I choose markets for a Price Ticker?" CornerRadius="0">
                    <TextBlock Text="Open Widgets, select a saved Price Ticker, choose or remove markets, and then select Save. Every panel assigned to that widget updates automatically." Style="{StaticResource BodyTextStyle}" Margin="16,0,16,0"/>
                </Expander>

                <Expander Header="How does the price flash setting work?" CornerRadius="0">
                    <TextBlock Text="When enabled for a panel, an upward tick turns the price green and a downward tick turns it red until the next update." Style="{StaticResource BodyTextStyle}" Margin="16,0,16,0"/>
                </Expander>

                <Expander Header="How do I size an overlay?" CornerRadius="0">
                    <TextBlock Text="Choose the overlay in Desktop Setup and set Width and Height together. X Tracker, Website, Wallet Watcher and Application window use the saved content height; the title bar is added automatically. Feeds scroll within that area. Price Ticker keeps its automatic row-based height. Sizes are in display-independent pixels (DIP), so Windows scaling still applies. Each overlay keeps its own size, even when sharing a widget. Large sizes are limited to the monitor's available space. Website, Application window, Wallet Watcher and X Tracker screen-edge panels use Thickness. Price Ticker sizes automatically: top and bottom panels wrap into rows, while left and right panels fill downward before adding columns. The existing 30% panel cap remains, with overflow scrolling inside the panel." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="16,0,16,0" />
                </Expander>

                <Expander Header="What is the difference between closing and deleting a panel?" CornerRadius="0">
                    <TextBlock Text="For both overlays and screen-edge panels, Minimize and the panel shortcut toggle the same running instance between visible and minimized. A minimized screen-edge panel releases its reserved desktop space. Close disposes the running content; its shortcut cannot reopen it, but Show or Start Desktop Display can. Deleting from Desktop Setup removes the saved panel. Quit TrenchHQ closes every panel and the dashboard." Style="{StaticResource BodyTextStyle}" Margin="16,0,16,0"/>
                </Expander>

                <Expander Header="Can I pin another application's window to a panel or overlay?" CornerRadius="0">
                    <TextBlock Text="In Desktop Setup, set Panel content to Application window, then Save and Show. Press Pin window, choose a running app and a pinning method, then Pin. Start with Native lock. If an app doesn't work properly, unpin it and try Embedded + lock (experimental). Both methods keep the window in place; Embedded + lock also clips it to the panel area. Some apps may work better with one method than the other. All methods load a small native helper into the selected app; they require a resizable, non-admin x64 window. Apps that block the helper are unavailable, and specialized app behavior may bypass a lock. Minimized/maximized apps restore automatically. Unpin, minimizing or closing the panel, switching content or hiding an overlay restores the original position, styles and window state without closing the app. A recovery timer also releases the app if TrenchHQ exits; recovery waits if the app is unresponsive. Embedding uses a container owned by the app, not TrenchHQ. No app choice or method is remembered between pins, and this does not reduce the app's RAM use. Overlay work-area limits and the 30% screen-edge panel cap still apply."
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="16,0,16,0" />
                </Expander>
                <Expander Header="How do I display a website on my desktop?" CornerRadius="0">
                    <TextBlock Text="In Widgets, add Website, enter an address such as example.com and Save. Assign it to an Overlay or a screen-edge panel on any edge in Desktop Setup and show that panel. Selecting Website automatically raises the minimum thickness for its 320 × 200 page area, and controls at the target display scale. The title-bar status dot reports page state without covering the website. The 30% panel cap remains: if the website cannot fit, choose another monitor or edge, or use an overlay. Saving an address loads the page when there is enough room; leaving it blank saves an empty widget. Set page Zoom in Widgets, and overlay Width/Height or panel Thickness in Desktop Setup. TrenchHQ displays the full website; the site controls its own features, pricing and update speed." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="16,0,16,0"/>
                </Expander>
                <Expander Header="How do website login and interaction lock work?" CornerRadius="0">
                    <TextBlock Text="Pages open ready for normal clicking, typing and scrolling. Sign in directly on the website. Each saved Website widget uses a separate local browser profile; panels using that same widget share its login. TrenchHQ does not import your normal browser session. The Lock button in the overlay title bar or docked-bar control strip blocks page interaction while the site keeps running; Unlock restores it. Lock does not prevent panel movement or make the overlay click-through. Sign out on the website before deleting a widget if you want to end its session; local profile data is retained." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="16,0,16,0"/>
                </Expander>
                <Expander Header="How does the Website widget save memory?" CornerRadius="0">
                    <TextBlock Text="Visible pages run normally, including when interaction is locked. Hidden or minimized panels request WebView2's low-memory mode and return to normal when shown. Scripts and connections keep running; this is not a pause or a fixed RAM limit. A browser is not started until its panel is visible, and closing the panel releases its WebView. New Website widgets share browser runtime processes but keep separate login profiles. Existing browser folders are preserved to avoid losing logins. Heavy websites can still use substantial memory."
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="16,0,16,0" />
                </Expander>
                <Expander Header="What if a website cannot load or sign in?" CornerRadius="0">
                    <TextBlock Text="Use Reload, check the URL and connection, or choose Open in browser. Some websites reject embedded browsers or require popup-based sign-in. This panel blocks new popup windows, downloads, device permissions and external-app launches. Open in browser uses a separate login and is not itself docked by TrenchHQ. Website compatibility is not guaranteed. Do not paste secret-bearing links into the saved URL." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="16,0,16,0"/>
                </Expander>
                <Expander Header="How is X Tracker different from Website?" CornerRadius="0">
                    <TextBlock Text="X Tracker is a native feed from the official paid X Filtered Stream. Enter and test an X developer app bearer token under API, then add accounts and enable loading in the X Tracker widget. Enabled trackers share one stream. Standard X delivery is within seconds, not guaranteed subsecond; Enterprise Powerstream is not included. Local text and post-type filters do not reduce API charges. Website displays an existing site's UI and does not turn its posts into TrenchHQ-native alerts or feeds." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="16,0,16,0"/>
                </Expander>
                <Expander Header="Where did the other X sources go?" CornerRadius="0">
                    <TextBlock Text="Unofficial session/RSS sources and third-party paid monitor adapters have been removed. Existing X watchlists remain. A removed active source is paused rather than silently enabling a paid X connection. Configure the official API, or create a Website widget to view an existing tracker. Historical research and test reports describe the older implementation, not current supported options." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="16,0,16,0"/>
                </Expander>
                <Expander Header="What happens when a chain API stops working?" CornerRadius="0">
                    <TextBlock Text="Enter a provider key and Save; TrenchHQ selects compatible providers per chain, switches on low local allowance or failures, and recovers after cooldowns or resets. Shared keys link supported chains; account-specific hosts also need endpoint URLs. Known free plans have conservative automatic daily usage guards, with optional overrides in Usage. These are local estimates, not actual account balances; other apps and custom plans can differ. Polling/event mode stays selected. PublicNode is the final best-effort fallback on Ethereum, Base, BNB, and Robinhood, and has no SLA. Solana has no equivalent key-free live provider. A chain pauses if no compatible provider remains." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="16,0,16,0"/>
                </Expander>

                <Expander Header="What does the dot beside Settings mean?" CornerRadius="0">
                    <TextBlock Text="Green means the active content is live and current. Amber means it is connecting, recovering or stale. Red means it is unavailable or has an error. Grey means it is stopped or not configured. The dot reports the active widget, website or pinned application without adding status text over its content." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="16,0,16,0"/>
                </Expander>

                <Expander Header="Where are my settings stored?" CornerRadius="0,0,12,12">
                    <TextBlock Text="Settings are stored in this Windows user's package data. Provider and X tokens use Windows DPAPI protection; wallet labels and addresses, website URLs and panel settings are local configuration. Closing a Website panel or deleting its widget does not erase its browser profile. Read Privacy for deletion and uninstall details. Export diagnostics includes only version, platform, memory and aggregate pipeline counters; no settings, credentials, addresses, URLs, browser data or raw errors are exported." Style="{StaticResource BodyTextStyle}" Margin="16,0,16,0"/>
                </Expander>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Margin="32,16,32,0" />

        <Grid Grid.Row="4" Margin="32,16,32,24">
            <StackPanel Spacing="10">
                <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextStyle}" />
                <TextBlock Text="No wallet signing, custody, exchange-account access or trading. Diagnostics are saved only when you request them and are never uploaded automatically." Style="{StaticResource HintTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PrivacyButton" Content="Privacy" Click="OnPrivacyClick" />
                    <Button x:Name="ExportDiagnosticsButton" Content="Export diagnostics" Click="OnExportDiagnosticsClick" />
                </StackPanel>
                <HyperlinkButton Content="Support and known issues" NavigateUri="https://github.com/gautamgpt1/TrenchHQ/issues" />
                <HyperlinkButton Content="Supported feeds and limitations" NavigateUri="https://gautamgpt1.github.io/TrenchHQ/support.html" />
                <TextBlock x:Name="SupportStatus" Style="{StaticResource HintTextStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
