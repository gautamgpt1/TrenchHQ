<UserControl
    x:Class="TrenchHQ.Views.DesktopSetupTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrenchHQ.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="32,24,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Desktop Setup" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Grid.Row="1"
                       Text="Choose a panel, then configure everything it shows and how it fits your desktop."
                       Style="{StaticResource PageSubtitleStyle}" />
        </Grid>

        <Border Grid.Row="1"
                Margin="32,12,32,0"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,0,0,1" />

        <Grid Grid.Row="2" Background="{StaticResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PanelSidebarColumn" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="PanelSidebar"
                  Grid.Column="0"
                  Background="{StaticResource AppBackgroundBrush}"
                  BorderBrush="{StaticResource SeparatorBrush}"
                  BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="16,10,12,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PanelHeadingText"
                               Text="Your panels (0)"
                               Style="{StaticResource SidebarTitleStyle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            AutomationProperties.Name="Add panel"
                            Padding="12,0"
                            MinHeight="32"
                            Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="+" FontSize="16" />
                            <TextBlock Text="Add" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Floating overlay" Click="OnAddOverlayClick" />
                                <MenuFlyoutItem Text="Screen-edge panel" Click="OnAddDockedBarClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <ListView x:Name="PanelList"
                          Grid.Row="1"
                          Background="Transparent"
                          BorderThickness="0"
                          DisplayMemberPath="Name"
                          SelectionMode="Single"
                          SelectionChanged="OnPanelSelectionChanged">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemForeground" Color="#B5B5B5" />
                        <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#4CE5C1" />
                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#4CE5C1" />
                        <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#4CE5C1" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>

            <Grid x:Name="PanelEditorHost"
                  Grid.Column="1"
                  Background="{StaticResource AppBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <Grid x:Name="EmptyState" Grid.RowSpan="2" Margin="32,16,32,28">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Button x:Name="EmptyPanelAddButton"
                            Width="48"
                            Height="48"
                            Padding="0"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            AutomationProperties.AutomationId="EmptyPanelAddButton"
                            AutomationProperties.Name="Add first panel"
                            Background="{StaticResource InputBackgroundBrush}"
                            BorderThickness="0"
                            CornerRadius="24">
                        <FontIcon Glyph="&#xE710;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Floating overlay" Click="OnAddOverlayClick" />
                                <MenuFlyoutItem Text="Screen-edge panel" Click="OnAddDockedBarClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock Text="Build your desktop setup" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Add a floating overlay or screen-edge panel to begin."
                               Style="{StaticResource HintTextStyle}"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelEditorHeader" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="32,16,32,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="PanelNameText"
                                   Style="{StaticResource EditorTitleStyle}" />
                        <TextBlock x:Name="SaveStatusText"
                                   Style="{StaticResource HintTextStyle}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ShowHideButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnShowHideClick">Show</Button>
                        <Button x:Name="CancelPanelButton" Style="{StaticResource StagedSecondaryButtonStyle}" Click="OnCancelClick">Cancel</Button>
                        <Button x:Name="SavePanelButton" Style="{StaticResource StagedPrimaryButtonStyle}" Click="OnSaveClick">Save</Button>
                        <Border Width="1" Height="24" Margin="4,0"
                                Background="{StaticResource SeparatorBrush}" />
                        <Button AutomationProperties.Name="Delete panel" Style="{StaticResource DangerIconButtonStyle}" Click="OnDeleteClick" ToolTipService.ToolTip="Delete panel">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1"
                        BorderBrush="{StaticResource SeparatorBrush}"
                        BorderThickness="0,0,0,1"
                        Margin="32,12,32,0" />
            </Grid>

            <ScrollViewer x:Name="EditorScrollViewer"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="32,16,32,0" Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Panel content" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="PanelContentSelector" Grid.Column="1" Width="360"
                                      HorizontalAlignment="Left" DisplayMemberPath="Name"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      AutomationProperties.Name="Panel content"
                                      PlaceholderText="Select content" SelectionChanged="OnPanelContentChanged" />
                        </Grid>
                    </StackPanel>

                    <Grid Margin="32,12,32,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Shortcut" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <Button x:Name="ShortcutEditButton" Grid.Column="1"
                                MinWidth="200"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButtonStyle}" Click="OnEditShortcutClick">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock x:Name="ShortcutButtonText" Text="Set shortcut" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border BorderBrush="{StaticResource SeparatorBrush}"
                            BorderThickness="0,0,0,1"
                            Margin="32,12,32,0" />

                    <Grid Margin="32,16,32,0" ColumnSpacing="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ContentSizeLabel" Text="Content size" Style="{StaticResource SubsectionTitleStyle}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ContentSizeSelector"
                                  Grid.Column="1"
                                  Width="160"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  AutomationProperties.Name="Panel content size"
                                  SelectionChanged="OnEditorValueChanged">
                            <ComboBoxItem Content="Small" Tag="small" />
                            <ComboBoxItem Content="Standard" Tag="standard" />
                            <ComboBoxItem Content="Large" Tag="large" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="Background" Style="{StaticResource SubsectionTitleStyle}" VerticalAlignment="Center" />
                        <Button x:Name="BackgroundColorButton"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                AutomationProperties.Name="Choose panel background color"
                                MinWidth="160"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnBackgroundColorClick">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border x:Name="BackgroundColorPreview" Width="18" Height="18" CornerRadius="9" />
                                <TextBlock x:Name="BackgroundColorText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Row="2" Text="Text" Style="{StaticResource SubsectionTitleStyle}" VerticalAlignment="Center" />
                        <Button x:Name="TextColorButton"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                AutomationProperties.Name="Choose panel text color"
                                MinWidth="160"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnTextColorClick">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border x:Name="TextColorPreview" Width="18" Height="18" CornerRadius="9" />
                                <TextBlock x:Name="TextColorText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="PriceFlashLabel" Grid.Row="3" Text="Price flash on change" Style="{StaticResource SubsectionTitleStyle}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="PriceFlashToggle"
                                       Grid.Row="3"
                                       Grid.Column="1"
                                      AutomationProperties.Name="Price flash on change"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Toggled="OnEditorValueChanged" />

                        <StackPanel x:Name="DockedBarPlacementPanel" Grid.Row="4" Grid.ColumnSpan="2" Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Position" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="PositionStatusText" Grid.Column="1" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
                                </Grid>
                                <controls:WrapPanel x:Name="MonitorDiagramPanel" HorizontalSpacing="16" VerticalSpacing="16" />
                                <Grid x:Name="ThicknessPanel" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Thickness" Style="{StaticResource SubsectionTitleStyle}" />
                                        <Slider x:Name="ThicknessSlider" StepFrequency="1" ValueChanged="OnThicknessChanged"
                                                TickPlacement="BottomRight" AutomationProperties.Name="Panel thickness" />
                                        <Grid Margin="8,0">
                                            <TextBlock x:Name="ThicknessMinimumText" HorizontalAlignment="Left" Style="{StaticResource HintTextStyle}" />
                                            <TextBlock x:Name="ThicknessMaximumText" HorizontalAlignment="Right" Style="{StaticResource HintTextStyle}" />
                                        </Grid>
                                        <TextBlock x:Name="ThicknessUnavailableText" Text="Website cannot fit on this edge within the size limit."
                                                   Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource WarningTextStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="ThicknessValueText" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" />
                                </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="OverlayOpacityPanel">
                        <Border BorderBrush="{StaticResource SeparatorBrush}"
                                BorderThickness="0,0,0,1"
                                Margin="32,12,32,0" />
                        <Grid Margin="32,16,32,0" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Opacity" Style="{StaticResource SectionTitleStyle}" />
                            <Grid Grid.Row="1" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Luminosity opacity" Style="{StaticResource SubsectionTitleStyle}" />
                                    <Slider x:Name="LuminositySlider" Minimum="0" Maximum="100" StepFrequency="1"
                                            AutomationProperties.Name="Luminosity opacity" ValueChanged="OnOpacityChanged" />
                                </StackPanel>
                                <TextBlock x:Name="LuminosityValueText" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" />
                            </Grid>
                            <Grid Grid.Row="2" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Tint opacity" Style="{StaticResource SubsectionTitleStyle}" />
                                    <Slider x:Name="TintSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                            AutomationProperties.Name="Tint opacity" ValueChanged="OnOpacityChanged" />
                                </StackPanel>
                                <TextBlock x:Name="TintValueText" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="OverlayPlacementPanel">
                        <Border BorderBrush="{StaticResource SeparatorBrush}"
                                BorderThickness="0,0,0,1"
                                Margin="32,12,32,0" />
                        <Grid Margin="32,16,32,0" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Overlay" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Grid.Row="1" Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Width" Style="{StaticResource SubsectionTitleStyle}" />
                                        <Slider x:Name="WidthSlider" Minimum="250" Maximum="600" StepFrequency="10" ValueChanged="OnWidthChanged"
                                                AutomationProperties.Name="Overlay width" TickFrequency="50" TickPlacement="Outside" />
                                    </StackPanel>
                                    <TextBlock x:Name="WidthValueText" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" />
                                </Grid>
                                <Grid x:Name="HeightPanel" Visibility="Collapsed" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Height" Style="{StaticResource SubsectionTitleStyle}" />
                                        <Slider x:Name="HeightSlider" Minimum="240" Maximum="900" StepFrequency="10" Value="480"
                                                ValueChanged="OnHeightChanged" AutomationProperties.Name="Overlay height"
                                                TickFrequency="60" TickPlacement="Outside" ToolTipService.ToolTip="Content height; the title bar is added automatically." />
                                    </StackPanel>
                                    <TextBlock x:Name="HeightValueText" Grid.Column="1" Margin="0,0,0,12" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <ContentDialog x:Name="ShortcutDialog" Title="Panel shortcut"
                       PrimaryButtonText="Save" CloseButtonText="Cancel" DefaultButton="None"
                       Opened="OnShortcutDialogOpened" PrimaryButtonClick="OnShortcutDialogSave" Closing="OnShortcutDialogClosing">
            <StackPanel Spacing="16" MinWidth="320">
                <TextBlock Text="Press Ctrl with Alt or Shift, then A-Z, 0-9 or F1-F11. Tab moves between controls; Esc cancels."
                           Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                <TextBox x:Name="ShortcutCaptureBox" IsReadOnly="True" PlaceholderText="Press shortcut keys"
                         FontSize="20" MinHeight="64" TextWrapping="Wrap"
                         AutomationProperties.Name="Shortcut key capture"
                         GotFocus="OnShortcutCaptureFocused" LostFocus="OnShortcutCaptureBlurred" />
                <TextBlock x:Name="ShortcutValidationText" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Reset" Style="{StaticResource SecondaryButtonStyle}" Click="OnResetShortcutClick" ToolTipService.ToolTip="Restore the shortcut from when this dialog opened" />
                    <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Click="OnClearShortcutClick" ToolTipService.ToolTip="Remove this shortcut when saved" />
                </StackPanel>
                <TextBlock Text="Save applies only this shortcut. Other panel changes are saved separately."
                           TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="BackgroundColorDialog"
                       Title="Panel background"
                       PrimaryButtonText="Apply"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <ColorPicker x:Name="BackgroundColorPicker" IsAlphaEnabled="False" />
        </ContentDialog>
        <ContentDialog x:Name="TextColorDialog"
                       Title="Panel text"
                       PrimaryButtonText="Apply"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <ColorPicker x:Name="TextColorPicker" IsAlphaEnabled="False" />
        </ContentDialog>
    </Grid>
</UserControl>
