<UserControl
    x:Class="TrenchHQ.Controls.SocialProviderSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrenchHQ.Controls">
    <StackPanel Spacing="12">
        <TextBlock Text="Official X API feed" Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Text="Optional paid native feed. Uses X Filtered Stream over one persistent HTTP connection, not refresh polling. Standard delivery is within seconds, not guaranteed subsecond; Enterprise Powerstream is not included."
                   TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
        <PasswordBox x:Name="SecretBox" Header="X developer app bearer token"
                     Style="{StaticResource InputPasswordBoxStyle}" PasswordChanged="OnSecretEdited" />
        <TextBlock Text="The token is encrypted for this Windows account and sent only to api.x.com. Use a dedicated X developer project. Testing opens a stream and may incur Post-read charges. Pause the feed before retesting. Only TrenchHQ-tagged account rules are managed; local display filters do not reduce API charges."
                   TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
            <Button x:Name="TestButton" Content="Test connection" Style="{StaticResource SecondaryButtonStyle}" Click="OnTestClick" />
            <Button x:Name="UseButton" Content="Save and use" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="OnUseClick" />
            <Button Content="Pause feed" Style="{StaticResource SecondaryButtonStyle}" Click="OnPauseClick" />
        </controls:WrapPanel>
        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
        <TextBlock x:Name="ActiveText" TextWrapping="Wrap" Style="{StaticResource HintTextStyle}" />
    </StackPanel>
</UserControl>
