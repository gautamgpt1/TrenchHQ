<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrenchHQ.Controls.PriceTickerWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrenchHQ.ViewModels"
    xmlns:controls="using:TrenchHQ.Controls">

    <Grid x:Name="WidgetRoot">
        <Grid.Resources>
            <SolidColorBrush x:Key="WidgetTextBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="WidgetSeparatorBrush" Color="#665A5A5A" />

            <DataTemplate x:Key="OverlayRowTemplate" x:DataType="local:PriceTickerRow">
                <Border Padding="{x:Bind OverlayPadding, Mode=OneWay}" BorderBrush="{StaticResource WidgetSeparatorBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="{x:Bind OverlayMargin, Mode=OneWay}" ColumnSpacing="{x:Bind OverlaySpacing, Mode=OneWay}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="{x:Bind OverlayIconSize, Mode=OneWay}"
                               Height="{x:Bind OverlayIconSize, Mode=OneWay}"
                               Source="{x:Bind IconSource, Mode=OneWay}"
                               Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                               Stretch="UniformToFill" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind DisplaySymbol, Mode=OneWay}"
                                   FontSize="{x:Bind OverlayFontSize, Mode=OneWay}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WidgetTextBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind DisplaySymbol, Mode=OneWay}" />
                        <TextBlock Grid.Column="2"
                                   MaxWidth="{x:Bind OverlayPriceMaxWidth, Mode=OneWay}"
                                   Text="{x:Bind PriceText, Mode=OneWay}"
                                   FontSize="{x:Bind OverlayFontSize, Mode=OneWay}"
                                   FontWeight="ExtraBold"
                                   Foreground="{x:Bind PriceForeground, Mode=OneWay}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   ToolTipService.ToolTip="{x:Bind PriceToolTip, Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="HorizontalBarRowTemplate" x:DataType="local:PriceTickerRow">
                <Border MinWidth="{x:Bind HorizontalMinWidth, Mode=OneWay}" MinHeight="{x:Bind HorizontalMinHeight, Mode=OneWay}" Padding="{x:Bind HorizontalPadding, Mode=OneWay}" BorderBrush="{StaticResource WidgetSeparatorBrush}" BorderThickness="0,0,1,1">
                    <Grid ColumnSpacing="{x:Bind HorizontalSpacing, Mode=OneWay}" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="{x:Bind HorizontalIconSize, Mode=OneWay}"
                               Height="{x:Bind HorizontalIconSize, Mode=OneWay}"
                               Source="{x:Bind IconSource, Mode=OneWay}"
                               Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Stretch="UniformToFill" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind DisplaySymbol, Mode=OneWay}"
                                   FontSize="{x:Bind HorizontalFontSize, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WidgetTextBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   ToolTipService.ToolTip="{x:Bind DisplaySymbol, Mode=OneWay}" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind PriceText, Mode=OneWay}"
                                   FontSize="{x:Bind HorizontalFontSize, Mode=OneWay}"
                                   FontWeight="Bold"
                                   Foreground="{x:Bind PriceForeground, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   ToolTipService.ToolTip="{x:Bind PriceToolTip, Mode=OneWay}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="VerticalBarRowTemplate" x:DataType="local:PriceTickerRow">
                <Border MinWidth="{x:Bind VerticalMinWidth, Mode=OneWay}" MinHeight="{x:Bind VerticalMinHeight, Mode=OneWay}" Padding="{x:Bind VerticalPadding, Mode=OneWay}" BorderBrush="{StaticResource WidgetSeparatorBrush}" BorderThickness="0,0,1,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{x:Bind VerticalSpacing, Mode=OneWay}">
                            <Image Width="{x:Bind VerticalIconSize, Mode=OneWay}"
                                   Height="{x:Bind VerticalIconSize, Mode=OneWay}"
                                   Source="{x:Bind IconSource, Mode=OneWay}"
                                   Visibility="{x:Bind IconVisibility, Mode=OneWay}"
                                   Stretch="UniformToFill" />
                            <TextBlock Text="{x:Bind DisplaySymbol, Mode=OneWay}"
                                       FontSize="{x:Bind VerticalFontSize, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WidgetTextBrush}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       ToolTipService.ToolTip="{x:Bind DisplaySymbol, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind PriceText, Mode=OneWay}"
                                   FontSize="{x:Bind VerticalFontSize, Mode=OneWay}"
                                   FontWeight="Bold"
                                   Foreground="{x:Bind PriceForeground, Mode=OneWay}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   ToolTipService.ToolTip="{x:Bind PriceToolTip, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid x:Name="OverlayLayout">
            <ItemsControl x:Name="OverlayRowsControl"
                          Margin="0,4"
                          ItemsSource="{x:Bind Rows, Mode=OneWay}"
                          ItemTemplate="{StaticResource OverlayRowTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <Grid x:Name="HorizontalBarLayout" Visibility="Collapsed">
            <ScrollViewer x:Name="HorizontalRowsScroller"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Auto"
                          VerticalScrollBarVisibility="Hidden"
                          SizeChanged="OnDockedViewportSizeChanged">
                <ItemsControl x:Name="HorizontalRowsControl"
                              Loaded="OnHorizontalRowsLoaded"
                              ItemsSource="{x:Bind Rows, Mode=OneWay}"
                              ItemTemplate="{StaticResource HorizontalBarRowTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WrapPanel Orientation="Horizontal" FirstLineEndInset="120" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="VerticalBarLayout" Visibility="Collapsed">
            <ScrollViewer x:Name="VerticalRowsScroller"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          SizeChanged="OnDockedViewportSizeChanged">
                <ItemsControl x:Name="VerticalRowsControl"
                              ItemsSource="{x:Bind Rows, Mode=OneWay}"
                              ItemTemplate="{StaticResource VerticalBarRowTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WrapPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
