<UserControl
    x:Class="TrenchHQ.Views.ProvidersTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrenchHQ.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="ProviderRowTemplate">
            <Border BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Tag="{Binding}"
                            AutomationProperties.Name="{Binding DisplayName}"
                            Padding="0"
                            MinHeight="54"
                            Background="Transparent"
                            BorderThickness="0"
                            FontWeight="Normal"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="OnProviderRowClick">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0CFFFFFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F5F5F5" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F5F5F5" />
                        </Button.Resources>
                        <Grid Padding="4,5" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid RowSpacing="4" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding DisplayName}"
                                           Style="{StaticResource ListItemTitleStyle}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding Badges}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,2"
                                                    MinHeight="22"
                                                    Background="{Binding Background}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="11">
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{Binding Foreground}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Border Grid.Column="1"
                                    Padding="8,3"
                                    Background="#243DD6B0"
                                    CornerRadius="10"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ConfiguredVisibility}">
                                <TextBlock Text="{Binding ConnectionRoleText}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Not configured"
                                       Style="{StaticResource HintTextStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding NotConfiguredVisibility}" />
                            <FontIcon Grid.Column="2"
                                      Glyph="{Binding ChevronGlyph}"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Grid.Row="1"
                            Padding="4,6,4,22"
                            Visibility="{Binding EditorVisibility}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Setup"
                                           Style="{StaticResource SubsectionTitleStyle}" />
                                <TextBlock Text="{Binding SetupInstructions}"
                                           Style="{StaticResource HintTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SupportedChainsText}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <HyperlinkButton Content="{Binding SetupLinkLabel}"
                                                 NavigateUri="{Binding SetupUri}"
                                                 Visibility="{Binding SetupLinkVisibility}"
                                                 Padding="0"
                                                 HorizontalAlignment="Left" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Streaming endpoint"
                                         Text="{Binding StreamEndpoint, Mode=TwoWay}"
                                         Style="{StaticResource InputTextBoxStyle}" />
                                <TextBox Grid.Column="1"
                                         Header="{Binding RpcEndpointHeader}"
                                         Text="{Binding RpcEndpoint, Mode=TwoWay}"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </Grid>

                            <PasswordBox Header="{Binding CredentialLabel}"
                                         Password="{Binding Credential, Mode=TwoWay}"
                                         PlaceholderText="{Binding CredentialPlaceholder}"
                                         PasswordRevealMode="Peek"
                                         Style="{StaticResource InputPasswordBoxStyle}" />

                            <ComboBox Header="Commitment"
                                      ItemsSource="{Binding CommitmentOptions}"
                                      SelectedIndex="{Binding CommitmentIndex, Mode=TwoWay}"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      HorizontalAlignment="Stretch"
                                      Visibility="{Binding CommitmentVisibility}" />

                            <StackPanel Margin="0,2,0,0" Spacing="10">
                                <TextBlock Text="{Binding StatusText}"
                                           Style="{StaticResource HintTextStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                                <Button
                                        Tag="{Binding}"
                                        Content="Remove"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Visibility="{Binding RemoveVisibility}"
                                        Click="OnRemoveProviderClick" />
                                <Button
                                        Tag="{Binding}"
                                        Content="Cancel"
                                        IsEnabled="{Binding IsDirty}"
                                        Style="{StaticResource StagedSecondaryButtonStyle}"
                                        Click="OnCancelProviderClick" />
                                <Button
                                        Tag="{Binding}"
                                        Content="Save"
                                        IsEnabled="{Binding IsDirty}"
                                        Style="{StaticResource StagedPrimaryButtonStyle}"
                                        Click="OnSaveProviderClick" />
                                </controls:WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="32,16,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="API Connections" Style="{StaticResource PageTitleStyle}" />
            <Button x:Name="UsageButton" Grid.Column="1" Grid.RowSpan="2" Content="Usage"
                    VerticalAlignment="Top" Margin="0,16,0,0"
                    Style="{StaticResource SecondaryButtonStyle}" Click="OnUsageBudgetsClick" />
            <TextBlock Grid.Row="1"
                       Text="Configure data connections for each chain and X."
                       Style="{StaticResource PageSubtitleStyle}"
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="1"
                Margin="32,12,32,0"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,0,0,1" />

        <Grid Grid.Row="2" Background="{StaticResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="API connections (6)" Margin="16,10,12,10"
                           Style="{StaticResource SidebarTitleStyle}" VerticalAlignment="Center" />
                <ListView x:Name="ApiSectionList" Grid.Row="1" SelectionMode="Single"
                          AutomationProperties.Name="API connections"
                          Background="Transparent" BorderThickness="0"
                          SelectionChanged="OnApiSectionSelectionChanged">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemForeground" Color="#B5B5B5" />
                        <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#4CE5C1" />
                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#4CE5C1" />
                        <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#4CE5C1" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="16,6" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListViewItem Tag="Solana" AutomationProperties.Name="Solana API settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Width="24" Height="24" Source="ms-appx:///Assets/Chains/solana.svg" Stretch="Uniform" />
                            <TextBlock Text="Solana" Style="{StaticResource ListItemTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="Ethereum" AutomationProperties.Name="Ethereum API settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Width="24" Height="24" Source="ms-appx:///Assets/Chains/ethereum.svg" Stretch="Uniform" />
                            <TextBlock Text="Ethereum" Style="{StaticResource ListItemTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="Base" AutomationProperties.Name="Base API settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Width="24" Height="24" Source="ms-appx:///Assets/Chains/base.svg" Stretch="Uniform" />
                            <TextBlock Text="Base" Style="{StaticResource ListItemTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="Bnb" AutomationProperties.Name="BNB Smart Chain API settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Width="24" Height="24" Source="ms-appx:///Assets/Chains/bnb-chain.svg" Stretch="Uniform" />
                            <TextBlock Text="BNB Smart Chain" Style="{StaticResource ListItemTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="Robinhood" AutomationProperties.Name="Robinhood Chain API settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="24" Height="24" Background="#CCFF00" CornerRadius="5">
                                <Image Width="15" Height="19" Source="ms-appx:///Assets/Chains/robinhood-chain.svg" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Robinhood Chain" Style="{StaticResource ListItemTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="X" AutomationProperties.Name="X API settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Viewbox Width="24" Height="24">
                                <Path Fill="{StaticResource TextPrimaryBrush}" Data="M18.901 1.153H22.581L14.541 10.343L24 22.846H16.594L10.794 15.262L4.154 22.846H0.472L9.072 13.016L0 1.154H7.594L12.837 8.086L18.901 1.153ZM17.61 20.644H19.649L6.486 3.24H4.298L17.61 20.644Z" />
                            </Viewbox>
                            <TextBlock Text="X" Style="{StaticResource ListItemTitleStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Grid>
            <ScrollViewer x:Name="ApiDetailsScrollViewer" Grid.Column="1"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch">
                <Grid Margin="32,18,32,28">
                    <StackPanel x:Name="SolanaApiSection" Spacing="28" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="34"
                                   Height="34"
                                   Source="ms-appx:///Assets/Chains/solana.svg"
                                   Stretch="Uniform"
                                   AutomationProperties.Name="Solana" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Solana" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="On-chain pools and prices"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="20">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Free" Style="{StaticResource GroupTitleStyle}" />
                                <ItemsControl x:Name="SolanaFreeProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Paid / trial" Style="{StaticResource GroupTitleStyle}" />
                                <ItemsControl x:Name="SolanaPaidProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Custom" Style="{StaticResource GroupTitleStyle}" />
                                <TextBlock Text="Use an endpoint supplied by another provider, your organization, or a self-hosted node. Cost and reliability depend on the endpoint owner."
                                           Style="{StaticResource HintTextStyle}"
                                           TextWrapping="Wrap" />
                                <ItemsControl x:Name="SolanaCustomProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="EthereumApiSection" Spacing="28" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="34"
                                   Height="34"
                                   Source="ms-appx:///Assets/Chains/ethereum.svg"
                                   Stretch="Uniform"
                                   AutomationProperties.Name="Ethereum" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ethereum" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="On-chain pools and prices"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="20">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Free" Style="{StaticResource GroupTitleStyle}" />
                                <ItemsControl x:Name="EthereumFreeProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Paid / trial" Style="{StaticResource GroupTitleStyle}" />
                                <ItemsControl x:Name="EthereumPaidProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Custom" Style="{StaticResource GroupTitleStyle}" />
                                <TextBlock Text="Use an endpoint supplied by another provider, your organization, or a self-hosted node. Cost and reliability depend on the endpoint owner."
                                           Style="{StaticResource HintTextStyle}"
                                           TextWrapping="Wrap" />
                                <ItemsControl x:Name="EthereumCustomProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="BaseApiSection" Spacing="28" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="34"
                                   Height="34"
                                   Source="ms-appx:///Assets/Chains/base.svg"
                                   Stretch="Uniform"
                                   AutomationProperties.Name="Base" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Base" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Uniswap V2-V4, Aerodrome, and PancakeSwap V2, V3, Infinity pools"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="20">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Free" Style="{StaticResource GroupTitleStyle}" />
                                <ItemsControl x:Name="BaseFreeProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Custom" Style="{StaticResource GroupTitleStyle}" />
                                <TextBlock Text="Use an endpoint supplied by another provider, your organization, or a self-hosted node. Cost and reliability depend on the endpoint owner."
                                           Style="{StaticResource HintTextStyle}"
                                           TextWrapping="Wrap" />
                                <ItemsControl x:Name="BaseCustomProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="BnbApiSection" Spacing="28" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="34"
                                   Height="34"
                                   Source="ms-appx:///Assets/Chains/bnb-chain.svg"
                                   Stretch="Uniform"
                                   AutomationProperties.Name="BNB Smart Chain" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="BNB Smart Chain" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="PancakeSwap V2, V3, Infinity, and Uniswap V2-V4 pools"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="20">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Free" Style="{StaticResource GroupTitleStyle}" />
                                <ItemsControl x:Name="BnbFreeProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Custom" Style="{StaticResource GroupTitleStyle}" />
                                <TextBlock Text="Use an endpoint supplied by another provider, your organization, or a self-hosted node. Cost and reliability depend on the endpoint owner."
                                           Style="{StaticResource HintTextStyle}"
                                           TextWrapping="Wrap" />
                                <ItemsControl x:Name="BnbCustomProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="RobinhoodApiSection" Spacing="28" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    Background="#CCFF00"
                                    CornerRadius="7">
                                <Image Width="20"
                                       Height="26"
                                       Source="ms-appx:///Assets/Chains/robinhood-chain.svg"
                                       Stretch="Uniform"
                                       AutomationProperties.Name="Robinhood Chain" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Robinhood Chain" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Uniswap V2, V3, and V4 pools"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="20">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Free" Style="{StaticResource GroupTitleStyle}" />
                                <ItemsControl x:Name="RobinhoodFreeProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Paid / trial" Style="{StaticResource GroupTitleStyle}" />
                                <ItemsControl x:Name="RobinhoodPaidProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Custom" Style="{StaticResource GroupTitleStyle}" />
                                <TextBlock Text="Use an endpoint supplied by another provider, your organization, or a self-hosted node. Cost and reliability depend on the endpoint owner."
                                           Style="{StaticResource HintTextStyle}"
                                           TextWrapping="Wrap" />
                                <ItemsControl x:Name="RobinhoodCustomProviderRows"
                                              ItemTemplate="{StaticResource ProviderRowTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="XApiSection" Spacing="28" Visibility="Collapsed">
                        <controls:SocialProviderSettingsControl />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
