<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TrenchHQ.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrenchHQ">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#4CE5C1</Color>
            <Color x:Key="SystemAccentColorLight1">#67EACB</Color>
            <Color x:Key="SystemAccentColorLight2">#84EED6</Color>
            <Color x:Key="SystemAccentColorLight3">#B0F5E6</Color>
            <Color x:Key="SystemAccentColorDark1">#35C9A8</Color>
            <Color x:Key="SystemAccentColorDark2">#27977E</Color>
            <Color x:Key="SystemAccentColorDark3">#196553</Color>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
            <x:Double x:Key="TextControlThemeMinHeight">36</x:Double>
            <x:Double x:Key="ContentDialogButtonMinHeight">36</x:Double>
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#0C0D0F" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#222428" />
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#F5F5F5" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#121315" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#F5F5F5" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#4CE5C1" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#67EACB" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#35C9A8" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#132F2A" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0E13" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0E13" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0B0E13" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#6D928A" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1B1D20" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#121315" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#44484F" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4CE5C1" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1B1D20" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#25272B" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#44484F" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#4CE5C1" />

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0C0D0F" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#222428" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C3C7CE" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#9298A1" />
            <SolidColorBrush x:Key="AccentBrush" Color="#4CE5C1" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#0B0E13" />
            <SolidColorBrush x:Key="InfoBrush" Color="#69B7FF" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F0A555" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF7B72" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#4CE5C1" />
            <SolidColorBrush x:Key="ActionButtonInactiveBrush" Color="#132F2A" />
            <SolidColorBrush x:Key="ActionButtonInactiveTextBrush" Color="#6D928A" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#121315" />
            <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#0D0D0D" />
            <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#0F0F0F" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="#202226" />

            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#B5B5B5" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#4CE5C1" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#4CE5C1" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#4CE5C1" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#4CE5C1" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#4CE5C1" />
            <SolidColorBrush x:Key="NavigationViewItemIconForeground" Color="#7A7A7A" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPointerOver" Color="#4CE5C1" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPressed" Color="#4CE5C1" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected" Color="#4CE5C1" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPointerOver" Color="#4CE5C1" />
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelectedPressed" Color="#4CE5C1" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemSelectionIndicatorForeground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0D0D0D" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0D0D0D" />

            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#25272B" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#303238" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#141518" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#686C73" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            <Thickness x:Key="ButtonBorderThemeThickness">0</Thickness>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SubsectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Margin" Value="4,4,0,4" />
            </Style>

            <Style x:Key="EditorTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SidebarTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ListItemTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="InfoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
            </Style>

            <Style x:Key="WarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            </Style>

            <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            </Style>

            <Style x:Key="SuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            </Style>

            <Style x:Key="InputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="InputPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Padding" Value="12,9,0,9" />
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="InputNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="StagedSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="StagedPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Background" Value="#1A1011" />
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#2A1518" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#3A1B20" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ChipBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="12,0,8,0" />
            </Style>

            <Style x:Key="ChipIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="MinHeight" Value="20" />
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}" />
            <Style TargetType="PasswordBox" BasedOn="{StaticResource InputPasswordBoxStyle}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource InputComboBoxStyle}" />
            <Style TargetType="NumberBox" BasedOn="{StaticResource InputNumberBoxStyle}" />
            <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="PrimaryButtonStyle" Value="{StaticResource PrimaryButtonStyle}" />
                <Setter Property="SecondaryButtonStyle" Value="{StaticResource SecondaryButtonStyle}" />
                <Setter Property="CloseButtonStyle" Value="{StaticResource SecondaryButtonStyle}" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="HyperlinkButton">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
